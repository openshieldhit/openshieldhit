# Differential scoring test case
# Exercises Diff1 / Diff1Type for EKIN, LET, and QEFF axes.

Geometry Mesh
    Name MyMesh
    X -5.0   5.0   1
    Y -5.0   5.0   1
    Z  0.0  20.0   1

Filter
    Name PrimaryFilter
    GEN = 0
    Z = 1
    A = 1

Output
    Filename NB_diff_ekin.dat
    Fileformat TEXT
    Geo MyMesh
    Quantity Fluence PrimaryFilter
    Diff1     0  500   10
    Diff1Type EKIN
    Quantity Dose PrimaryFilter
    Diff1     0  500   10
    Diff1Type EKIN

Output
    Filename NB_diff_let.dat
    Fileformat TEXT
    Geo MyMesh
    Quantity Fluence PrimaryFilter
    Diff1     0.1  100.0  5  LOG
    Diff1Type LET

Output
    Filename NB_diff_qeff.dat
    Fileformat TEXT
    Geo MyMesh
    Quantity Fluence PrimaryFilter
    Diff1     0  5000  10
    Diff1Type QEFF

Output
    Filename NB_diff2_ekin_let.dat
    Fileformat TEXT
    Geo MyMesh
    Quantity Fluence PrimaryFilter
    Diff1     0  500   5
    Diff1Type EKIN
    Diff2     0.1  100.0  5  LOG
    Diff2Type LET

Output
    Filename NB_plain.dat
    Fileformat TEXT
    Geo MyMesh
    Quantity Fluence
    Quantity Dose
